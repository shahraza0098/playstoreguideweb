# ==========================================
# PlayStoreGuide Environment Variables
# ==========================================

# ------------------------------------------
# 1. Email Delivery Service (Resend)
# ------------------------------------------
# Resend API Key for sending transactional contact emails.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified domain sender email address.
# In production, this MUST use a verified address on your domain (e.g., @playstoreguide.com).
# Unverified senders or onboarding@resend.dev are strictly rejected in production.
CONTACT_FROM_EMAIL=PlayStoreGuide Inquiries <support@playstoreguide.com>

# Destination email inbox where developer inquiries are delivered.
CONTACT_TO_EMAIL=support@playstoreguide.com

# ------------------------------------------
# 2. Alternative Delivery Fallback (Webhook)
# ------------------------------------------
# Optional webhook endpoint (Slack, Discord, CRM, or Zapier).
# Only utilized if RESEND_API_KEY is not configured.
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ------------------------------------------
# 3. Distributed Serverless Rate Limiting (Upstash Redis)
# ------------------------------------------
# Optional Upstash Redis REST credentials for distributed rate limiting across serverless edge/lambda instances.
# If unset, an in-memory sliding window rate limiter is used as a fallback for local/single-server environments.
# Obtain from https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ------------------------------------------
# 4. Bot Verification & Abuse Prevention (Cloudflare Turnstile)
# ------------------------------------------
# Optional Cloudflare Turnstile secret key for server-side verification.
# If unset, honeypot and velocity rate limiting serve as the active multi-layer defense.
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ------------------------------------------
# 5. Site Canonical Hostname
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.playstoreguide.com
